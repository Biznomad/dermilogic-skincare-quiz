{% comment %}
  Dermilogic concern-first skincare quiz. Install on an unpublished theme first.
  Source: build_shopify.py + public/app.js + skincare.py. See HANDOFF.md.
{% endcomment %}
<dermilogic-skin-quiz id="DermilogicQuiz-{{ section.id }}" data-currency="{{ cart.currency.iso_code }}" data-root="{{ routes.root_url }}" data-cart-url="{{ routes.cart_url }}">
  <template>
    <link rel="stylesheet" href="{{ 'dermilogic-skin-quiz.css' | asset_url }}">
    <main id="main">
<section class="hero" id="intro">
<div class="hero-copy"><p class="eyebrow">THE SKINCARE FINDER</p><h1>{{ section.settings.heading | escape }}</h1><p class="lede">{{ section.settings.intro | escape }}</p><button class="primary" id="start">{{ section.settings.button_label | escape }} <span aria-hidden="true">↗</span></button><p class="micro">Five questions · No skin photos · No purchase needed</p><div class="head-strip"><div><strong>Understand first. Choose second.</strong><p>Skincare guidance, with room to keep it simple.</p></div></div></div>
<div class="hero-photo">{% if section.settings.hero_image != blank %}{{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: "lazy", alt: section.settings.hero_image.alt }}{% else %}<div class="image-placeholder">Your skin.<br>Your starting point.</div>{% endif %}<div class="photo-note"><span>CARE STARTS WITH UNDERSTANDING</span><p>Less guesswork.<br>More thoughtful care.</p></div></div>
</section>
<section id="quiz" class="quiz-layout" hidden aria-label="Routine finder">
<aside class="quiz-aside"><p class="eyebrow">YOUR EVERYDAY RESET</p><h2>A few details.<br>A clearer choice.</h2><p>We start with your concerns, your comfort, and the routine you already have.</p><small>Educational guidance, not a diagnosis.</small></aside>
<div class="quiz-content"><div class="progress-label"><span id="step-label"></span><span id="step-caption">Your starting point</span></div><div class="progress" role="progressbar" aria-label="Quiz progress" aria-valuemin="0" aria-valuemax="5" aria-valuenow="0"><div id="progress-fill"></div></div><form id="quiz-form"><fieldset><legend id="question" tabindex="-1"></legend><p id="question-note"></p><p class="auto-note">Choose an answer to move to the next question. You can go back at any time.</p><div id="options"></div></fieldset><div class="quiz-actions"><button type="button" class="text-button" id="back">← Back</button><button type="submit" class="primary" id="next" disabled>Continue →</button></div></form><p class="error" id="quiz-error" role="alert"></p></div>
</section>
<section id="results" class="results" hidden><p class="eyebrow">YOUR SKINCARE STARTING POINT</p><h2 tabindex="-1" id="result-heading">Your next step.</h2><p id="match-why" class="result-intro"></p><p id="saved-message" class="saved" role="status"></p><div id="routine-steps" class="skincare-steps"></div><p id="routine-note" class="routine-note"></p><div class="result-grid" id="result-grid"><div class="result-image" id="result-image-wrap"><img id="result-image" alt="" width="800" height="800"></div><div class="result-copy"><span class="pill" id="product-label">WHERE DERMILOGIC CAN FIT</span><h3 id="match-name"></h3><p id="product-why"></p><a class="primary shop-link" id="shop-link" target="_blank" rel="noopener"></a><p id="catalog-gap" class="fine"></p></div></div><section id="bundle" class="bundle" hidden aria-labelledby="bundle-title"><p class="eyebrow">CHOSEN AROUND YOUR ANSWERS</p><h3 id="bundle-title"></h3><p class="bundle-intro">A starting selection, with a reason for every item. Uncheck anything you do not need.</p><div id="bundle-items" class="bundle-items"></div><div class="bundle-summary"><div><span id="bundle-count"></span><strong id="bundle-total" aria-live="polite"></strong><small>Item subtotal · Shipping and taxes confirmed in the store.</small></div><button class="primary" id="bundle-action" type="button">Review selected items in store ↗</button></div><p id="bundle-message" class="fine" role="status"></p><p class="fine" id="bundle-price-note">One-time items at individual prices; no bundle discount is applied. Final price and availability are confirmed by the cart.</p><p class="fine">Moisturizer and sunscreen are still separate essentials. These items do not replace those steps.</p></section><p id="care-notice" class="care-notice"></p><p class="fine">Guidance informed by the <a href="https://www.aad.org/public/everyday-care/skin-care-basics/care/skin-care-budget" target="_blank" rel="noopener">American Academy of Dermatology’s routine basics</a> and <a href="https://www.aad.org/public/diseases/acne/skin-care/tips" target="_blank" rel="noopener">blemish-prone skin guidance</a>. Product links are shopping suggestions, not medical endorsements.</p><button class="text-button" id="restart">↺ Start again</button></section>
</main>
    <slot></slot>
  </template>
  {% assign bundle_kinds = 'cleanser,patches,towels,bands' | split: ',' %}
  {% for kind in bundle_kinds %}
    {% case kind %}
      {% when 'cleanser' %}{% assign bundle_product = section.settings.cleanser_product %}{% assign explanation = section.settings.cleanser_description %}
      {% when 'patches' %}{% assign bundle_product = section.settings.patch_product %}{% assign explanation = section.settings.patch_description %}
      {% when 'towels' %}{% assign bundle_product = section.settings.towel_product %}{% assign explanation = '' %}
      {% when 'bands' %}{% assign bundle_product = section.settings.band_product %}{% assign explanation = '' %}
    {% endcase %}
    {% assign bundle_variant = bundle_product.selected_or_first_available_variant %}
    <div hidden data-product="{{ kind }}" data-title="{{ bundle_product.title | escape }}" data-url="{{ bundle_product.url | escape }}" data-available="{% if bundle_variant.available and bundle_product.requires_selling_plan != true %}true{% else %}false{% endif %}" data-description="{{ explanation | escape }}" data-variant-id="{{ bundle_variant.id }}" data-variant-label="{% unless bundle_variant.title == 'Default Title' %}{{ bundle_variant.title | escape }}{% endunless %}" data-price="{{ bundle_variant.price }}" data-image="{% if bundle_product.featured_image %}{{ bundle_product.featured_image | image_url: width: 800 }}{% endif %}"></div>
  {% endfor %}
  {% if section.settings.enable_signup %}
    {% assign form_id = 'DermilogicSignup-' | append: section.id %}
    <div class="dl-skin-quiz-signup" data-newsletter hidden>
      <h2>{{ section.settings.signup_heading | escape }}</h2>
      <p>Results are yours to use without subscribing. Join only if you want skincare tips and product news.</p>
      {% form 'customer', id: form_id %}
        <input type="hidden" name="contact[tags]" value="newsletter,dermilogic-skin-quiz">
        {% if form.posted_successfully? %}
          <p role="status" data-form-result>Your signup was received. Check your inbox for any confirmation required by this store.</p>
        {% else %}
          {% if form.errors %}<div role="alert" data-form-result>{{ form.errors | default_errors }}</div>{% endif %}
          <label for="DermilogicEmail-{{ section.id }}">Email address</label>
          <input id="DermilogicEmail-{{ section.id }}" type="email" name="contact[email]" value="{{ form.email | escape }}" autocomplete="email" required>
          <label class="dl-skin-quiz-consent" for="DermilogicConsent-{{ section.id }}">
            <input id="DermilogicConsent-{{ section.id }}" type="checkbox" name="contact[accepts_marketing]" value="true" required>
            <span>{{ section.settings.consent_copy | escape }}</span>
          </label>
          {% if shop.privacy_policy.url != blank %}<a href="{{ shop.privacy_policy.url }}">Privacy policy</a>{% endif %}
          <button type="submit">Join the email list</button>
        {% endif %}
      {% endform %}
    </div>
  {% endif %}
  <noscript><p>Enable JavaScript to use the skincare quiz. You can also <a href="{{ routes.all_products_collection_url }}">browse the store</a>.</p></noscript>
</dermilogic-skin-quiz>
<script src="{{ 'dermilogic-skin-quiz.js' | asset_url }}" defer></script>
{% stylesheet %}
  .dl-skin-quiz-signup { max-width: 640px; margin: 32px auto; padding: 24px; border: 1px solid #c9d9d5; border-radius: 8px; }
  .dl-skin-quiz-signup[hidden] { display: none; }
  .dl-skin-quiz-signup input[type="email"] { display: block; width: 100%; padding: 14px; margin: 8px 0 20px; }
  .dl-skin-quiz-consent { display: flex; gap: 12px; margin: 20px 0; }
  .dl-skin-quiz-signup button { display: block; padding: 14px 24px; background: #14665e; color: white; border: 0; margin-top: 20px; cursor: pointer; }
{% endstylesheet %}
{% schema %}
{
  "name": "Dermilogic skincare quiz",
  "tag": "section",
  "limit": 1,
  "enabled_on": { "templates": ["page", "index"] },
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your skin. A clearer direction." },
    { "type": "textarea", "id": "intro", "label": "Introduction", "default": "Breakouts, dry-feeling skin, or simply too much advice? Tell us what’s on your mind. Leave with a practical routine and products that have a reason to be there." },
    { "type": "text", "id": "button_label", "label": "Start button", "default": "Find my routine" },
    { "type": "image_picker", "id": "hero_image", "label": "Skincare lifestyle image" },
    { "type": "product", "id": "cleanser_product", "label": "Gentle cleanser product" },
    { "type": "textarea", "id": "cleanser_description", "label": "Why this cleanser fits", "default": "A fragrance-free cleanser option for the cleansing step. Review the ingredients and introduce it gradually; individual tolerance varies." },
    { "type": "product", "id": "patch_product", "label": "Hydrocolloid patch product" },
    { "type": "textarea", "id": "patch_description", "label": "Why these patches fit", "default": "An optional hydrocolloid cover for an occasional surface spot. It will not treat deep, painful, or persistent acne." },
    { "type": "product", "id": "towel_product", "label": "Optional facial towels" },
    { "type": "product", "id": "band_product", "label": "Optional wash bands" },
    { "type": "checkbox", "id": "enable_signup", "label": "Enable optional newsletter signup", "default": false, "info": "Enable after testing the store’s customer form and confirming consent copy. Skin answers are not submitted." },
    { "type": "text", "id": "signup_heading", "label": "Signup heading", "default": "Keep your skincare simple." },
    { "type": "textarea", "id": "consent_copy", "label": "Email consent copy", "default": "Yes, send me Dermilogic skincare tips and product offers by email. I can unsubscribe at any time." }
  ],
  "presets": [{ "name": "Dermilogic skincare quiz" }]
}
{% endschema %}
